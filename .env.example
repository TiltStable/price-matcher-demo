# Database connection string.
# Default: PostgreSQL started via docker-compose (see docker-compose.yml).
DATABASE_URL=postgresql+psycopg://pricematcher:pricematcher@localhost:5432/pricematcher

# OpenAI API key (OPTIONAL — used only by the LLM-verifier cascade stage).
# If not set, the matcher runs without the LLM stage (rules + fuzzy + normalization).
# OPENAI_API_KEY=sk-...

# Logging level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
